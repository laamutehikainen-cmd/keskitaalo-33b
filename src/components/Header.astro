---
import { withBase } from "../lib/content";

interface Props {
  locale: "fi" | "en";
  page: "guide" | "levi";
  navigation: {
    guide: string;
    levi: string;
    language: string;
    menu: string;
  };
}

const { locale, page, navigation } = Astro.props;
const guideHref = withBase(locale === "fi" ? "/" : "/en/");
const leviHref = withBase(locale === "fi" ? "/levi/" : "/en/levi/");
const languageHref = withBase(
  locale === "fi"
    ? page === "guide" ? "/en/" : "/en/levi/"
    : page === "guide" ? "/" : "/levi/"
);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href={guideHref} aria-label="Keskitaalo 33B">
      <span class="wordmark-number">33B</span>
      <span class="wordmark-name">Keskitaalo</span>
    </a>

    <nav class="desktop-nav" aria-label={locale === "fi" ? "Päänavigaatio" : "Main navigation"}>
      <a href={guideHref} aria-current={page === "guide" ? "page" : undefined}>{navigation.guide}</a>
      <a href={leviHref} aria-current={page === "levi" ? "page" : undefined}>{navigation.levi}</a>
    </nav>

    <div class="header-actions">
      <div class="language-switch" aria-label={locale === "fi" ? "Kielivalinta" : "Language selection"}>
        {locale === "fi" ? (
          <>
            <span aria-current="true">FI</span>
            <a href={languageHref} lang="en" aria-label="View this page in English">EN</a>
          </>
        ) : (
          <>
            <a href={languageHref} lang="fi" aria-label="Näytä tämä sivu suomeksi">FI</a>
            <span aria-current="true">EN</span>
          </>
        )}
      </div>

      <details class="mobile-nav">
        <summary>{navigation.menu}<span class="menu-lines" aria-hidden="true"></span></summary>
        <nav aria-label={locale === "fi" ? "Mobiilinavigaatio" : "Mobile navigation"}>
          <a href={guideHref} aria-current={page === "guide" ? "page" : undefined}>{navigation.guide}</a>
          <a href={leviHref} aria-current={page === "levi" ? "page" : undefined}>{navigation.levi}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
